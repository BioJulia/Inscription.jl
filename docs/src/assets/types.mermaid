%% Generate types.svg from this file with mermaid-cli, from this directory:
%%   npx -p @mermaid-js/mermaid-cli mmdc -i types.mermaid -o types.svg -b white -c cfg.json
%% where cfg.json contains:
%%   {"htmlLabels":false,"flowchart":{"htmlLabels":false},"fontFamily":"sans-serif",
%%    "themeVariables":{"fontFamily":"sans-serif"},"themeCSS":".edgeLabel rect{opacity:1;fill:#e6e6e6;}"}
%% htmlLabels=false makes plain SVG text labels, which render inside an <img> tag.
%% To use a system Chromium instead of letting Puppeteer download one, add `-p pptr.json`,
%% where pptr.json contains: {"executablePath":"/usr/bin/chromium","args":["--no-sandbox"]}
flowchart TD
Y[Encodings of bounded size?] --> |No| X[Not supported by BitScribbling.jl]
Y --> |Yes| Z[Bitstype?]
Z --> |No| C
Z --> |Yes| A
A[Struct or primitive type?] --> |Struct| B[Contains padding on any platform? see Structs]
B --> |Yes| C[Can it be converted to and from another type, e.g. a tuple?]
B --> |No| D[All fields recursively BitsLoadable?]
D --> |Yes| E[Implement BitsLoadable]
D --> |No| F[All fields recursively BitsStorable?]
F --> |Yes| G[Implement BitsStorable]
F --> |No| C

A --> |Primitive| H[Bit size multiple of 8?]
H --> |No| I[Implement Manual, see Odd Sized Primitives]
H --> |Yes| J[Storage same bits as in-memory representation?]
J --> |No| C
J --> |Yes| K[All bitpatterns valid?]
K --> |Yes| E
K --> |No| G

C --> |Yes| P[Declare Proxy]
C --> |No| M[Implement Manual]
